# an758x-ont-autoflash 本地配置模板
# 用法：脚本运行时自动读/写同目录的 .env（已 gitignore，不会入库）。
#       本文件仅作键名与默认值参考，一般无需手动创建 .env，按提示输入即可。

# 当前机型（MD=诺基亚 XG-040G-MD（移动）；TF=诺基亚 XG-040G-TF（电信），管理 CGI 走 :8080；
#           MF=诺基亚 XG-040G-MF（移动），管理 CGI 与登录均走 :80）
DEVICE_MODEL=MD

# Web 超管凭据（各机型出厂默认值；若被运维改过，运行时输入实际值即可）
MD_WEB_USER=CMCCAdmin
MD_WEB_PASS=aDm8H%MdA
TF_WEB_USER=telecomadmin
TF_WEB_PASS=nE7jA%5m
MF_WEB_USER=CMCCAdmin
MF_WEB_PASS=aDm8H%MdA

# 光猫地址（原厂固件默认）
ROUTER_IP=192.168.1.1

# 本机 HTTP 服务 IP（光猫通过它访问电脑下载/上传文件；
# 主菜单第 1 步会列出本机已绑定 IP 供选择并自动写入，也可用 --http-ip 强制指定）
HTTP_IP=192.168.1.254

# TFTP 备用方案地址（当前流程用 HTTP，TFTP 代码保留备用）
TFTP_IP=192.168.1.254

# SuPassword 超密：由第 3 步 fetch-supass 自动提取并写入，无需手填
# （MD 从设备日志明文提取；TF / MF 从 dumpdatamodel.cgi 抓密文后用 AES 解密）
# 注意：每台设备唯一，切勿提交到公开仓库
# SU_PASS=
